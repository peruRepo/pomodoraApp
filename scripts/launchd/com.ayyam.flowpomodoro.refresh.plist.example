<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ayyam.flowpomodoro.refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>REPLACE_WITH_PROJECT_DIR/scripts/refresh-iphone.sh</string>
    <string>REPLACE_WITH_IPHONE_NAME_OR_ID</string>
  </array>

  <key>WorkingDirectory</key>
  <string>REPLACE_WITH_PROJECT_DIR</string>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>43200</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/tmp/com.ayyam.flowpomodoro.refresh.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/com.ayyam.flowpomodoro.refresh.stderr.log</string>
</dict>
</plist>
